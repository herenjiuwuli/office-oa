# 复制成 .env 后按需填写（.env 已被 .gitignore 忽略，不会进仓库）
#
# 不填也能跑：AI 摘要是可选能力，没配 key 时接口会返回
# { available:false, reason:"AI 摘要未启用：未配置 DEEPSEEK_API_KEY" }，
# 界面上的「AI 摘要」按钮会置灰，其余功能完全不受影响。

# 后端端口（默认 3200）
PORT=3200

# DeepSeek —— 仅「AI 审批摘要」用到
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 附件上传（都有默认值，一般不用改）
# UPLOAD_DIR=./data/uploads          # 附件落盘目录（默认 data/uploads）
# MAX_UPLOAD_BYTES=5242880           # 单文件上限，默认 5MB
# MAX_FILES_PER_REQUEST=5            # 每张单据附件数上限，默认 5
