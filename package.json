{
  "name": "office-oa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "办公 OA 系统（M1：地基三件套 + 审批流 + 前端）—— 一个专门用来被测试的 OA",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently -n be,fe -c green,blue \"node --watch index.js\" \"npm --prefix web run dev\"",
    "dev:be": "node --watch index.js",
    "dev:fe": "npm --prefix web run dev",
    "seed": "node seed.js",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:frontend": "node scripts/check-vue-undef.mjs web/src && node scripts/check-vue-tpl.mjs web/src && node scripts/check-vue-refvalue.mjs web/src/views",
    "check:frontend:undef": "node scripts/check-vue-undef.mjs web/src",
    "check:frontend:tpl": "node scripts/check-vue-tpl.mjs web/src",
    "check:frontend:refvalue": "node scripts/check-vue-refvalue.mjs web/src/views",
    "check:docs": "node scripts/check-doc-refs.mjs",
    "check:ui": "node scripts/oa-ui-check.mjs",
    "shots": "node scripts/oa-screenshots.mjs",
    "demo": "node scripts/oa-demo-record.mjs",
    "test:e2e": "node e2e/seed-e2e.mjs && playwright test",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run check:frontend && npm run check:docs && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.4",
    "vitest": "^4.1.11"
  }
}
