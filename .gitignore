node_modules/
dist/
test-results/
coverage/

# 真机断言的失败现场（截图 + 页面文本 + report.txt）—— 是产物，不进仓库。
# ⚠️ 刻意不放 test-results/：那是 Playwright 的目录，它每次启动都会清空它（见脚本内注释）
evidence/

# Playwright 产物
playwright-report/
blob-report/
.playwright/

# 本地数据库不进仓库（可能含真实数据，见 README 安全红线）
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 清库前的备份也不进仓库
data/backups/
data/app.db.bak-*

# 录屏的抽帧产物（调试用，DEMO_STILLS=1 时才生成）
docs/demo/frames/

# 附件上传目录（用户上传的文件不进仓库）
data/uploads/
data/e2e-uploads/

# 本地环境变量
.env
.env.local

*.log
